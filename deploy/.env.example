# Copy to .env next to docker-compose.yml and fill in real values.
# .env is git-ignored — never commit real credentials.

# External MySQL. Format: user:password@tcp(host:port)/database
SQL_DSN=user:password@tcp(mysql.example.com:3306)/newapi

# Image tag to run. `latest` follows the newest successful build; pin a
# 7-character commit SHA (e.g. NEW_API_TAG=593f864) to freeze or roll back.
NEW_API_TAG=latest

# Login signing secret (optional). Leave empty to let the "keep users signed in
# after restarts" switch (System Settings > Authentication > Basic
# Authentication) decide: it is on by default and keeps the key in the
# database, so restarts and updates do not sign users out. When set, this value
# is used instead and the switch has no effect. Generate it once with
# `openssl rand -hex 32` and never change it: setting or changing it signs
# everyone out once. Several nodes: set the same value on every node, or leave
# it empty on all of them so they share the key kept in the database.
# After setting or changing it (or CRYPTO_SECRET below), run
# `docker compose up -d`: it recreates the container. `docker compose restart`
# does not read .env again, so the container keeps the old value. The value
# reaches the container only if the server's docker-compose.yml passes
# SESSION_SECRET (this repository's does since the switch was added), so update
# an older copy of that file first. To check: the startup log has
# "SESSION_SECRET is set" and the switch is greyed out (DEPLOY.md, section 22).
SESSION_SECRET=

# Encryption secret: a long random string (openssl rand -hex 32), set once and
# never changed. Empty falls back to the login signing key (SESSION_SECRET, or
# the key kept in the database while the switch above is on); only with the
# switch off and neither variable set is it random at every restart, and then
# the per-user safety identifier an OpenAI channel sends with
# send_safety_identifier changes at every restart. Changing it also invalidates
# task result download links issued before; a deployment that already sets
# SESSION_SECRET can leave this empty or set the same value.
CRYPTO_SECRET=
